# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

gem "activerecord", "~> 6.1.0"
gem "rake", "~> 13.0"
gem "sqlite3", "~> 1.4"

# Rails < 7.1 breaks with concurrent-ruby 1.3.5+ and relies on gems Ruby 3.4 no longer ships by default
gem "base64"
gem "bigdecimal"
gem "concurrent-ruby", "< 1.3.5"
gem "logger"
gem "mutex_m"
